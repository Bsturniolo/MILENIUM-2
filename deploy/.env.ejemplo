# Copiar este archivo como .env (en esta misma carpeta) y completar.
# El .env NO se sube a GitHub.

# Dominio o subdominio que apunta al servidor, sin https:// (ej: maquinas.midominio.com.ar)
DOMINIO=maquinas.ejemplo.com.ar

# Clave de administrador de la app: larga y al azar. Generarla con:
#   openssl rand -hex 24
MILENIUM_ADMIN_TOKEN=

# Desde qué páginas se puede usar la app además de la del propio servidor (/app/).
# Separadas por coma. La de GitHub ya viene incluida si se deja vacío.
MILENIUM_ORIGENES=https://bsturniolo.github.io

# Clave compartida con la tienda web para firmar los pedidos (ver docs/TIENDA-WEB.md).
# Generarla con: openssl rand -hex 32
MILENIUM_TIENDA_SECRETO=
