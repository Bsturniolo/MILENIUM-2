# Configuración de la tienda. Al arrancar por primera vez se copia a datos/config.env: completalo ahí.
# Una línea por dato, sin espacios alrededor del "=".

# 1 = pagos de prueba (no se cobra nada). Dejalo en 1 hasta conectar Mercado Pago.
TIENDA_PRUEBA=1

# Mercado Pago: el "Access Token" de producción de tu cuenta (ver docs/PASOS.md). Vacío = sin Mercado Pago.
MP_ACCESS_TOKEN=

# (Opcional) Conectar con Milenium 2 u otro sistema: cada pedido pagado se le manda para registrarlo como venta.
# Ej: CONECTAR_URL=https://milenium.midominio.com.ar/tienda/pedido
CONECTAR_URL=
# La misma clave que MILENIUM_TIENDA_SECRETO en el servidor de Milenium 2 (larga y al azar).
CONECTAR_CLAVE=
