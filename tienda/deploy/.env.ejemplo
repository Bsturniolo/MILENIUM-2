# Copiar este archivo como .env (en esta misma carpeta) y completar. El .env NO se sube a GitHub.

# Dominio de la tienda, sin https:// (ej: www.mitienda.com.ar)
DOMINIO=tienda.ejemplo.com.ar

# Dirección pública completa, con https:// (la misma del DOMINIO). Mercado Pago vuelve y avisa acá.
TIENDA_URL=https://tienda.ejemplo.com.ar

# Clave para entrar al panel: larga y al azar. Generarla con:  openssl rand -hex 24
TIENDA_ADMIN_TOKEN=

# Mercado Pago: Access Token de PRODUCCIÓN de la cuenta que cobra (ver docs/PASOS.md).
MP_ACCESS_TOKEN=
# (Opcional) "Clave secreta" de las notificaciones (Webhooks) de Mercado Pago, para verificar cada aviso.
MP_WEBHOOK_SECRETO=

# Dejar en 0 en la tienda de verdad. 1 = pagos de prueba (solo si no hay MP_ACCESS_TOKEN).
TIENDA_PRUEBA=0

# Letras del número de pedido (W-00001)
TIENDA_PREFIJO=W

# (Opcional) Conectar con Milenium 2 u otro sistema
CONECTAR_URL=
CONECTAR_CLAVE=
